{
  "name": "dumb-assistant",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:milestone-0": "node scripts/validate-milestone-0.mjs",
    "check": "npm run validate:milestone-0 && npm run typecheck && npm test"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "ajv": "^8.17.1",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.4",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.2",
    "expo-dev-client": "~58.0.8",
    "expo-file-system": "~58.0.7",
    "expo-linking": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.10",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.3",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-audio-api": "^0.12.0",
    "react-native-executorch": "^0.9.0",
    "react-native-executorch-expo-resource-fetcher": "^0.9.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.0.4"
  }
}
